{
  "name": "clipgenius-ai",
  "version": "1.0.0",
  "private": true,
  "description": "ClipGenius AI — turn long videos into engaging vertical clips with AI",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev -H 0.0.0.0",
    "build": "next build",
    "start": "next start -H 0.0.0.0",
    "worker": "tsx worker/index.ts",
    "typecheck": "tsc --noEmit",
    "db:start": "tsx scripts/db.ts start",
    "db:stop": "tsx scripts/db.ts stop",
    "db:status": "tsx scripts/db.ts status",
    "migrate": "tsx scripts/migrate.ts",
    "db:reset": "tsx scripts/db.ts reset && tsx scripts/migrate.ts",
    "seed": "tsx scripts/seed.ts",
    "e2e": "tsx scripts/e2e.ts",
    "setup": "tsx scripts/setup.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.637.0",
    "@aws-sdk/lib-storage": "^3.637.0",
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "jose": "^5.6.3",
    "lucide-react": "0.436.0",
    "next": "^14.2.15",
    "nodemailer": "^6.9.14",
    "pg": "^8.12.0",
    "pg-boss": "^12.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.12.7",
    "stripe": "^16.9.0",
    "tailwind-merge": "^2.5.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.5.0",
    "@types/nodemailer": "^6.4.15",
    "@types/pg": "^8.11.6",
    "@types/react": "^18.3.4",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "embedded-postgres": "17.5.0-beta.15",
    "postcss": "^8.4.41",
    "tailwindcss": "^3.4.10",
    "tsx": "^4.17.0",
    "typescript": "^5.5.4"
  }
}
