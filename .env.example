# =============================================================
# ClipGenius AI — environment configuration
# Copy to .env.local and fill in the values. Server-side only.
# =============================================================

# --- Core ---
# Public URL of the app (used for links in emails / Stripe redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Secret for signing session JWTs (generate: openssl rand -hex 32)
JWT_SECRET=change-me-to-a-long-random-string

# --- PostgreSQL ---
# Any Postgres 14+ works (Supabase, Neon, RDS...). For local dev run `npm run db:start`
# which boots an embedded Postgres and prints/writes the URL below.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/clipgenius

# --- Storage ---
# local (default) stores files under STORAGE_DIR; s3 uses the S3_* settings below
STORAGE_DRIVER=local
STORAGE_DIR=./data/storage
# S3 / S3-compatible (Cloudflare R2, AWS S3, MinIO...). Required when STORAGE_DRIVER=s3
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# --- AI (Google Gemini) ---
# Used for speech transcription, highlight selection and metadata generation.
# Without a key the app falls back to the local analysis engine (no transcript).
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: override models
GEMINI_TRANSCRIBE_MODEL=gemini-2.5-flash
GEMINI_HIGHLIGHT_MODEL=gemini-2.5-flash

# --- Stripe (subscriptions) ---
# https://dashboard.stripe.com/apikeys — webhook endpoint: {APP_URL}/api/billing/webhook
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Price IDs for the paid plans (create recurring prices in Stripe)
STRIPE_PRICE_CREATOR=
STRIPE_PRICE_PRO=
STRIPE_PRICE_AGENCY=

# --- Email (password recovery) ---
# Any SMTP relay (Resend, Postmark, SES, Gmail app-password...).
# If unset, password-reset links are logged and shown in the dev response.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="ClipGenius AI <no-reply@clipgenius.ai>"

# --- Admin ---
# Comma-separated emails that receive the admin role on signup
ADMIN_EMAILS=

# --- Limits tuning (optional) ---
MAX_UPLOAD_MB=2048
RATE_LIMIT_RPM=120
